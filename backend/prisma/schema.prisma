generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model api_keys {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  created_by      String        @db.Uuid
  name            String        @db.VarChar(255)
  key_prefix      String        @db.VarChar(20)
  key_hash        String        @db.VarChar(255)
  scopes          Json?         @default("[]")
  last_used_at    DateTime?     @db.Timestamptz(6)
  expires_at      DateTime?     @db.Timestamptz(6)
  revoked_at      DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  users           users         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_api_keys_org")
  @@index([key_prefix], map: "idx_api_keys_prefix")
}

model audit_logs {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?        @db.Uuid
  user_id         String?        @db.Uuid
  action          String         @db.VarChar(150)
  module          String?        @db.VarChar(50)
  target_type     String?        @db.VarChar(100)
  target_id       String?        @db.Uuid
  ip_address      String?        @db.Inet
  user_agent      String?
  details         Json?          @default("{}")
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_logs_created")
  @@index([organization_id], map: "idx_audit_logs_org")
  @@index([user_id], map: "idx_audit_logs_user")
}

model invitations {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  email           String        @db.VarChar(255)
  role_id         String        @db.Uuid
  token           String        @unique @db.VarChar(255)
  invited_by      String        @db.Uuid
  expires_at      DateTime      @db.Timestamptz(6)
  accepted_at     DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  users           users         @relation(fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles           roles         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organization_id], map: "idx_invitations_org")
  @@index([token], map: "idx_invitations_token")
}

model memberships {
  id                                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                             String        @db.Uuid
  organization_id                     String        @db.Uuid
  role_id                             String        @db.Uuid
  workspace_id                        String?       @db.Uuid
  status                              String        @default("active") @db.VarChar(50)
  invited_by                          String?       @db.Uuid
  invited_at                          DateTime?     @db.Timestamptz(6)
  joined_at                           DateTime?     @db.Timestamptz(6)
  created_at                          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime      @default(now()) @db.Timestamptz(6)
  users_memberships_invited_byTousers users?        @relation("memberships_invited_byTousers", fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations                       organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles                               roles         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_memberships_user_idTousers    users         @relation("memberships_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces                          workspaces?   @relation(fields: [workspace_id], references: [id], onUpdate: NoAction)

  @@unique([user_id, organization_id, workspace_id])
  @@index([organization_id], map: "idx_memberships_org")
  @@index([status], map: "idx_memberships_status")
  @@index([user_id], map: "idx_memberships_user")
}

model organizations {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(255)
  slug            String            @unique @db.VarChar(100)
  domain          String?           @db.VarChar(255)
  plan            String            @default("free") @db.VarChar(50)
  status          String            @default("active") @db.VarChar(50)
  trial_ends_at   DateTime?         @db.Timestamptz(6)
  sso_enabled     Boolean           @default(false)
  sso_provider    String?           @db.VarChar(50)
  scim_enabled    Boolean           @default(false)
  mfa_required    Boolean           @default(false)
  ip_allowlist    Json?             @default("[]")
  data_residency  String?           @default("global") @db.VarChar(50)
  settings        Json?             @default("{}")
  metadata        Json?             @default("{}")
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)
  tax_country     String?           @default("FR") @db.VarChar(2)
  api_keys        api_keys[]
  audit_logs      audit_logs[]
  companies       companies[]
  contacts        contacts[]
  deals           deals[]
  invitations     invitations[]
  invoices        invoices[]
  memberships     memberships[]
  products        products[]
  quotes          quotes[]
  roles           roles[]
  stock_movements stock_movements[]
  warehouses      warehouses[]
  workspaces      workspaces[]

  @@index([slug], map: "idx_organizations_slug")
  @@index([status], map: "idx_organizations_status")
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique @db.VarChar(150)
  module           String             @db.VarChar(50)
  action           String             @db.VarChar(50)
  description      String?
  role_permissions role_permissions[]

  @@index([module], map: "idx_permissions_module")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String?            @db.Uuid
  name             String             @db.VarChar(100)
  is_system        Boolean            @default(false)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  invitations      invitations[]
  memberships      memberships[]
  role_permissions role_permissions[]
  organizations    organizations?     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model users {
  id                                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                     String            @unique @db.VarChar(255)
  email_verified                            Boolean           @default(false)
  password_hash                             String?           @db.VarChar(255)
  full_name                                 String?           @db.VarChar(255)
  avatar_url                                String?
  mfa_enabled                               Boolean           @default(false)
  mfa_secret                                String?           @db.VarChar(255)
  last_login_at                             DateTime?         @db.Timestamptz(6)
  last_login_ip                             String?           @db.Inet
  status                                    String            @default("active") @db.VarChar(50)
  preferences                               Json?             @default("{}")
  metadata                                  Json?             @default("{}")
  created_at                                DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at                                DateTime?         @db.Timestamptz(6)
  api_keys                                  api_keys[]
  audit_logs                                audit_logs[]
  companies                                 companies[]
  contacts                                  contacts[]
  deals                                     deals[]
  invitations                               invitations[]
  invoices                                  invoices[]
  memberships_memberships_invited_byTousers memberships[]     @relation("memberships_invited_byTousers")
  memberships_memberships_user_idTousers    memberships[]     @relation("memberships_user_idTousers")
  products                                  products[]
  quotes                                    quotes[]
  stock_movements                           stock_movements[]

  @@index([email], map: "idx_users_email")
}

model workspaces {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String        @db.VarChar(255)
  slug            String        @db.VarChar(100)
  description     String?
  settings        Json?         @default("{}")
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  memberships     memberships[]
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, slug])
  @@index([organization_id], map: "idx_workspaces_org")
}

model companies {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String        @db.VarChar(255)
  website         String?       @db.VarChar(255)
  industry        String?       @db.VarChar(100)
  size            String?       @db.VarChar(50)
  notes           String?
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?     @db.Timestamptz(6)
  users           users?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contacts        contacts[]
  deals           deals[]
  invoices        invoices[]
  quotes          quotes[]

  @@index([organization_id], map: "idx_companies_org")
}

model contacts {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  company_id      String?       @db.Uuid
  first_name      String        @db.VarChar(100)
  last_name       String?       @db.VarChar(100)
  email           String?       @db.VarChar(255)
  phone           String?       @db.VarChar(50)
  job_title       String?       @db.VarChar(150)
  notes           String?
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?     @db.Timestamptz(6)
  companies       companies?    @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  users           users?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deals           deals[]
  invoices        invoices[]
  quotes          quotes[]

  @@index([company_id], map: "idx_contacts_company")
  @@index([organization_id], map: "idx_contacts_org")
}

model deals {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String        @db.Uuid
  company_id          String?       @db.Uuid
  contact_id          String?       @db.Uuid
  title               String        @db.VarChar(255)
  value               Decimal?      @default(0) @db.Decimal(14, 2)
  currency            String?       @default("EUR") @db.VarChar(10)
  stage               String        @default("prospect") @db.VarChar(50)
  expected_close_date DateTime?     @db.Date
  notes               String?
  created_by          String?       @db.Uuid
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?     @db.Timestamptz(6)
  companies           companies?    @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  contacts            contacts?     @relation(fields: [contact_id], references: [id], onUpdate: NoAction)
  users               users?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations       organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices            invoices[]
  quotes              quotes[]

  @@index([company_id], map: "idx_deals_company")
  @@index([organization_id], map: "idx_deals_org")
  @@index([stage], map: "idx_deals_stage")
}

model invoice_items {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id  String   @db.Uuid
  description String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unit_price  Decimal  @default(0) @db.Decimal(14, 2)
  line_total  Decimal  @default(0) @db.Decimal(14, 2)
  position    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  invoices    invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_items_invoice")
}

model invoices {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  quote_id        String?         @db.Uuid
  deal_id         String?         @db.Uuid
  company_id      String?         @db.Uuid
  contact_id      String?         @db.Uuid
  invoice_number  String          @db.VarChar(50)
  status          String          @default("draft") @db.VarChar(50)
  currency        String?         @default("EUR") @db.VarChar(10)
  subtotal        Decimal         @default(0) @db.Decimal(14, 2)
  tax_rate        Decimal?        @default(0) @db.Decimal(5, 2)
  total           Decimal         @default(0) @db.Decimal(14, 2)
  amount_paid     Decimal         @default(0) @db.Decimal(14, 2)
  due_date        DateTime?       @db.Date
  paid_at         DateTime?       @db.Timestamptz(6)
  notes           String?
  created_by      String?         @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?       @db.Timestamptz(6)
  invoice_items   invoice_items[]
  companies       companies?      @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  contacts        contacts?       @relation(fields: [contact_id], references: [id], onUpdate: NoAction)
  users           users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deals           deals?          @relation(fields: [deal_id], references: [id], onUpdate: NoAction)
  organizations   organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotes          quotes?         @relation(fields: [quote_id], references: [id], onUpdate: NoAction)

  @@unique([organization_id, invoice_number])
  @@index([deal_id], map: "idx_invoices_deal")
  @@index([organization_id], map: "idx_invoices_org")
  @@index([status], map: "idx_invoices_status")
}

model quote_items {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id    String   @db.Uuid
  description String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unit_price  Decimal  @default(0) @db.Decimal(14, 2)
  line_total  Decimal  @default(0) @db.Decimal(14, 2)
  position    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  quotes      quotes   @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quote_id], map: "idx_quote_items_quote")
}

model quotes {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  deal_id         String?       @db.Uuid
  company_id      String?       @db.Uuid
  contact_id      String?       @db.Uuid
  quote_number    String        @db.VarChar(50)
  status          String        @default("draft") @db.VarChar(50)
  currency        String?       @default("EUR") @db.VarChar(10)
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  tax_rate        Decimal?      @default(0) @db.Decimal(5, 2)
  total           Decimal       @default(0) @db.Decimal(14, 2)
  valid_until     DateTime?     @db.Date
  notes           String?
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?     @db.Timestamptz(6)
  invoices        invoices[]
  quote_items     quote_items[]
  companies       companies?    @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  contacts        contacts?     @relation(fields: [contact_id], references: [id], onUpdate: NoAction)
  users           users?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deals           deals?        @relation(fields: [deal_id], references: [id], onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, quote_number])
  @@index([deal_id], map: "idx_quotes_deal")
  @@index([organization_id], map: "idx_quotes_org")
  @@index([status], map: "idx_quotes_status")
}

model tax_rates {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country_code String   @db.VarChar(2)
  label        String   @db.VarChar(100)
  rate         Decimal  @db.Decimal(5, 2)
  is_default   Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([country_code], map: "idx_tax_rates_country")
}

model products {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  sku             String            @db.VarChar(100)
  name            String            @db.VarChar(255)
  description     String?
  unit_price      Decimal           @default(0) @db.Decimal(14, 2)
  currency        String?           @default("EUR") @db.VarChar(10)
  unit            String?           @default("piece") @db.VarChar(20)
  reorder_point   Decimal?          @default(0) @db.Decimal(10, 2)
  is_active       Boolean           @default(true)
  created_by      String?           @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)
  users           users?            @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stock_movements stock_movements[]

  @@unique([organization_id, sku])
  @@index([organization_id], map: "idx_products_org")
}

model stock_movements {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  product_id      String        @db.Uuid
  warehouse_id    String        @db.Uuid
  type            String        @db.VarChar(20)
  quantity        Decimal       @db.Decimal(10, 2)
  reason          String?       @db.VarChar(255)
  reference       String?       @db.VarChar(100)
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  users           users?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products      @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouses      warehouses    @relation(fields: [warehouse_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_stock_movements_org")
  @@index([product_id], map: "idx_stock_movements_product")
  @@index([warehouse_id], map: "idx_stock_movements_warehouse")
}

model warehouses {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  name            String            @db.VarChar(255)
  address         String?
  is_default      Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  stock_movements stock_movements[]
  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_warehouses_org")
}
